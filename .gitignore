# ── Dependencies (server + frontend) ──────────────────────────────────────
node_modules/
server/node_modules/
frontend/node_modules/

# ── Build output ──────────────────────────────────────────────────────────
dist/
server/dist/
frontend/dist/

# ── Environment variables (NEVER commit secrets) ──────────────────────────
.env
server/.env
frontend/.env

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
server/logs/

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Test coverage ─────────────────────────────────────────────────────────
coverage/
server/coverage/
frontend/coverage/

# ── TypeScript incremental build cache ────────────────────────────────────
*.tsbuildinfo

# ── Vite cache ────────────────────────────────────────────────────────────
frontend/.vite/

# ── Claude Code internal ──────────────────────────────────────────────────
.claude