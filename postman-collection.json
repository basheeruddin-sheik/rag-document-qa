{
  "info": {
    "name": "RAG Document Q&A Engine",
    "description": "API collection for the RAG-powered Document Q&A Engine built with NestJS + pgvector + OpenAI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Returns {status: ok} if the server is running."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"status\": \"ok\"\n}"
        }
      ]
    },
    {
      "name": "Upload PDF",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Select a PDF file to upload (max 50MB)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/upload",
          "host": ["{{baseUrl}}"],
          "path": ["upload"]
        },
        "description": "Upload a PDF file. It will be parsed, chunked (500 chars / 50 overlap), embedded via OpenAI text-embedding-3-small, and stored in pgvector."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"message\": \"Document ingested successfully\",\n  \"chunks\": 42\n}"
        },
        {
          "name": "No file provided",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"statusCode\": 400,\n  \"message\": \"No file provided\",\n  \"error\": \"Bad Request\"\n}"
        },
        {
          "name": "Non-PDF file",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"statusCode\": 400,\n  \"message\": \"Only PDF files are accepted\",\n  \"error\": \"Bad Request\"\n}"
        },
        {
          "name": "Server Error",
          "status": "Internal Server Error",
          "code": 500,
          "body": "{\n  \"statusCode\": 500,\n  \"message\": \"Failed to ingest document\",\n  \"error\": \"Internal Server Error\"\n}"
        }
      ]
    },
    {
      "name": "Query Document",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is the main topic of the document?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/query",
          "host": ["{{baseUrl}}"],
          "path": ["query"]
        },
        "description": "Ask a question against the uploaded documents. Embeds the question, runs cosine similarity search (top 5 chunks) in pgvector, then passes context to GPT-4o for an answer."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"answer\": \"The document discusses...\",\n  \"sources\": [\n    \"document.pdf (chunk 3)\",\n    \"document.pdf (chunk 7)\",\n    \"document.pdf (chunk 12)\"\n  ]\n}"
        },
        {
          "name": "No documents uploaded yet",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"answer\": \"No relevant documents found. Please upload a PDF first.\",\n  \"sources\": []\n}"
        },
        {
          "name": "Missing question",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"statusCode\": 400,\n  \"message\": \"question field is required\",\n  \"error\": \"Bad Request\"\n}"
        },
        {
          "name": "Server Error",
          "status": "Internal Server Error",
          "code": 500,
          "body": "{\n  \"statusCode\": 500,\n  \"message\": \"Failed to process query\",\n  \"error\": \"Internal Server Error\"\n}"
        }
      ]
    }
  ]
}
